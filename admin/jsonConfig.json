{
    "type": "panel",
    "items": {
        "url": {
            "type": "text",
            "label": {
                "en": "WAIP server URL",
                "de": "WAIP-Server-URL"
            },
            "help": {
                "en": "Base URL of the WAIP dispatch server (Socket.IO endpoint, namespace /waip is appended automatically)",
                "de": "Basis-URL des WAIP-Leitstellenservers (Socket.IO-Endpunkt, Namespace /waip wird automatisch angehängt)"
            },
            "sm": 12,
            "md": 8,
            "lg": 6
        },
        "monitorID": {
            "type": "text",
            "label": {
                "en": "Monitor ID",
                "de": "Monitor-ID"
            },
            "help": {
                "en": "Leave empty or use '0' to register as global monitor",
                "de": "Leer lassen oder '0' verwenden, um sich als globaler Monitor zu registrieren"
            },
            "sm": 12,
            "md": 8,
            "lg": 6
        },
        "_divider1": {
            "type": "divider"
        },
        "registrationTimeoutSec": {
            "type": "number",
            "label": {
                "en": "Registration timeout (s)",
                "de": "Registrierungs-Timeout (s)"
            },
            "min": 1,
            "max": 120,
            "sm": 12,
            "md": 6,
            "lg": 4
        },
        "reconnectDelaySec": {
            "type": "number",
            "label": {
                "en": "Reconnect delay (s)",
                "de": "Wiederverbindungs-Verzögerung (s)"
            },
            "min": 1,
            "max": 120,
            "sm": 12,
            "md": 6,
            "lg": 4
        },
        "sessionKeepaliveIntervalSec": {
            "type": "number",
            "label": {
                "en": "Session keepalive interval (s)",
                "de": "Session-Keepalive-Intervall (s)"
            },
            "help": {
                "en": "How often the server session cookie (GET /session/keepalive) is renewed, so the alarm feed keeps working uninterrupted without a real browser session",
                "de": "Wie oft der Server-Session-Cookie (GET /session/keepalive) erneuert wird, damit die Alarm-Zustellung auch ohne echte Browsersitzung ununterbrochen weiterläuft"
            },
            "min": 30,
            "max": 600,
            "sm": 12,
            "md": 6,
            "lg": 4
        }
    }
}
